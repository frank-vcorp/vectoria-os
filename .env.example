# SystronIA OS — variables de entorno

# PostgreSQL (requerida en producción)
DATABASE_URL=postgresql://vectoria:vectoria@localhost:5432/vectoria

# Sesiones (generar con: openssl rand -hex 32)
SESSION_SECRET=change-me-in-production

# URL pública de la app (PDFs, correos, enlaces absolutos)
NEXT_PUBLIC_APP_URL=https://os.vector-ia.mx

# Facturapi (Fase 6 — solo servidor)
FACTURAPI_API_KEY=

# Puerto (default 43123)
PORT=43123

# Entorno
NODE_ENV=development
